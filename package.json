{
  "name": "lichen",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run && node --test cli/test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply lichen --local",
    "db:migrate:remote": "wrangler d1 migrations apply lichen --remote",
    "test:worker": "vitest run",
    "test:cli": "node --test cli/test/*.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@vitest/runner": "^4.1.12",
    "@vitest/snapshot": "^4.1.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.166.0"
  }
}
